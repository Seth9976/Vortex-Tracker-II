object ExpSNDHDlg: TExpSNDHDlg
  Left = 222
  Height = 158
  Top = 174
  Width = 236
  BorderStyle = bsDialog
  Caption = 'SNDH file parameters'
  ClientHeight = 158
  ClientWidth = 236
  Position = poMainFormCenter
  ShowHint = True
  LCLVersion = '4.8.0.0'
  OnShow = FormShow
  object LbYear: TLabel
    Left = 8
    Height = 15
    Top = 8
    Width = 147
    Caption = 'Year of release (empty if no)'
    ParentColor = False
  end
  object EdYear: TEdit
    AnchorSideLeft.Control = LbYear
    AnchorSideLeft.Side = asrBottom
    AnchorSideTop.Control = LbYear
    AnchorSideTop.Side = asrCenter
    Left = 159
    Height = 23
    Hint = '4 digits or empty'
    Top = 4
    Width = 56
    BorderSpacing.Left = 4
    TabOrder = 0
    OnChange = EdYearChange
  end
  object CBNonPacked: TCheckBox
    AnchorSideLeft.Control = LbYear
    AnchorSideTop.Control = LbYear
    AnchorSideTop.Side = asrBottom
    Left = 8
    Height = 19
    Hint = 'Uncheck to pack SNDH with PACK-ICE v2.35 algorithm'
    Top = 27
    Width = 109
    BorderSpacing.Top = 4
    Caption = 'Save non-packed'
    TabOrder = 1
  end
  object BtOK: TButton
    Left = 38
    Height = 25
    Top = 122
    Width = 75
    Caption = 'OK'
    Default = True
    ModalResult = 1
    TabOrder = 3
  end
  object BtCancel: TButton
    Left = 123
    Height = 25
    Top = 122
    Width = 75
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
    TabOrder = 4
  end
  object RGDuration: TRadioGroup
    Left = 8
    Height = 65
    Top = 48
    Width = 219
    AutoFill = True
    Caption = 'Duration precision'
    ChildSizing.LeftRightSpacing = 6
    ChildSizing.EnlargeHorizontal = crsHomogenousChildResize
    ChildSizing.EnlargeVertical = crsHomogenousChildResize
    ChildSizing.ShrinkHorizontal = crsScaleChilds
    ChildSizing.ShrinkVertical = crsScaleChilds
    ChildSizing.Layout = cclLeftToRightThenTopToBottom
    ChildSizing.ControlsPerLine = 1
    ClientHeight = 45
    ClientWidth = 215
    ItemIndex = 0
    Items.Strings = (
      'SNDH v2.2 FRMS (frames)'
      'SNDH v2 TIME (seconds)'
    )
    TabOrder = 2
  end
end
